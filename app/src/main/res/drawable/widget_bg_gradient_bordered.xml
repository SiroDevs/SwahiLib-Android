<?xml version="1.0" encoding="utf-8"?>
<!-- Full pill for the 1x2 compact "Neno" widget: single gradient panel with a
     navy outline, no separate icon block. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/widget_gradient_start"
        android:endColor="@color/widget_gradient_end"
        android:angle="0" />
    <corners android:radius="16dp" />
    <stroke
        android:width="2dp"
        android:color="@color/widget_navy" />
</shape>
