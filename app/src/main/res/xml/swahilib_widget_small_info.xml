<?xml version="1.0" encoding="utf-8"?>
<!-- 1x2: a compact pill showing just today's word, no label - matches the
     smallest of the three "Neno la Siku" mockups. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="40dp"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:description="@string/widget_small_description"
    android:previewLayout="@layout/widget_preview_small" />
